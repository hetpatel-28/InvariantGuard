[
  {
    "name": "idempotency_key_reuse",
    "description": "Creating a payment twice with the same Idempotency-Key must return the same payment",
    "steps": [
      {
        "method": "POST",
        "path": "/payments",
        "body": {
          "amount": 100,
          "currency": "INR"
        },
        "headers": {
          "Idempotency-Key": "key-123"
        },
        "save_as": "p1",
        "repeat": 1
      },
      {
        "method": "POST",
        "path": "/payments",
        "body": {
          "amount": 100,
          "currency": "INR"
        },
        "headers": {
          "Idempotency-Key": "key-123"
        },
        "save_as": "p2",
        "repeat": 1
      }
    ]
  },
  {
