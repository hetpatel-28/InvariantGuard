  {
    "name": "Idempotency Key Reuse on Creation",
    "description": "Sends multiple payment creation requests with the same Idempotency-Key to ensure duplicate payments are not created.",
    "steps": [
      {
        "method": "POST",
        "path": "/payments",
        "body": {
          "amount": 1000,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "test-key-12345"
        },
        "save_as": "p_id_1",
        "repeat": 1
      },
      {
        "method": "POST",
        "path": "/payments",
        "body": {
          "amount": 2000,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "test-key-12345"
        },
        "save_as": "p_id_2",
        "repeat": 1
      }
    ]
  },
